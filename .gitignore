# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Certbot — certificates are generated at runtime, never commit them
certbot/conf/*
!certbot/conf/.gitkeep
certbot/www/*
!certbot/www/.gitkeep

# Server chat logs — runtime data, not source code
server/logs/

# Environment files with secrets
.env
.env.production

# Local working backups (created during manual edits, not part of the app)
_backup_*/

# Claude Code local tooling (browser-preview launch config)
.claude/
