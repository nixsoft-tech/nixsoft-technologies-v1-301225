# Copy this file to `.env` (gitignored) and fill in real values.
# docker-compose loads `.env` automatically; the compose file refuses to
# start if any required value below is missing.

# ─── Required secrets ─────────────────────────────────────────────────────────
# Admin dashboard password (long random string — used by /api/admin/chats)
ADMIN_PASSWORD=

# NixBot chat AI (server-side only — never exposed to the browser).
# Set at least one key; providers are tried in AI_PROVIDERS order and the
# next one is used automatically if a provider fails. With no key at all
# the chat runs in demo mode.
#   Grok (xAI):  https://console.x.ai     DeepSeek:  https://platform.deepseek.com
XAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional overrides (defaults shown)
# AI_PROVIDERS=grok,deepseek
# XAI_MODEL=grok-4.7
# DEEPSEEK_MODEL=deepseek-flash
# AI_TIMEOUT_MS=20000

# NixBot abuse limits (optional; defaults shown)
# CHAT_RATE_PER_MINUTE=8     messages per visitor IP per minute
# CHAT_RATE_PER_HOUR=60      messages per visitor IP per hour
# AI_DAILY_LIMIT=1500        total AI replies per day (caps worst-case spend)

# SMTP app password for the contact form mailbox
SMTP_PASS=

# Database credentials (generate strong random values)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ─── Optional overrides (sensible defaults in docker-compose.yml) ─────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=sales@nixsoftech.in
# CONTACT_EMAIL=sales@nixsoftech.in
# Comma-separated list of origins allowed to call the API
# ALLOWED_ORIGINS=https://new.nixsoftech.in

# Canonical origin used for <link rel="canonical">, og:url, and JSON-LD.
# Defaults to https://nixsoftech.in (production apex — www 301s to it).
# Leave unset for production. Baked in at BUILD time, not runtime: changing it
# requires a rebuild, and it must never be set to a UAT host in a production
# build or every page will canonicalize to staging.
# VITE_SITE_URL=https://nixsoftech.in
